          },
          "patient_id": {
            "type": "string",
            "pattern": "^HF-\\d{4}$",
            "title": "Patient Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Session Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "pin",
              "defer",
