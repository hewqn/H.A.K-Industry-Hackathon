  "components": {
    "schemas": {
      "CohortRead": {
        "properties": {
          "cohort_id": {
            "type": "string",
            "title": "Cohort Id"
          },
          "source_hash": {
            "type": "string",
            "title": "Source Hash"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "accepted_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepted Ids"
          },
          "accepted_count": {
            "type": "integer",
            "title": "Accepted Count"
          },
          "source_count": {
            "type": "integer",
            "title": "Source Count"
          },
          "excluded_count": {
            "type": "integer",
            "title": "Excluded Count"
          },
          "missing_rows": {
            "type": "integer",
            "title": "Missing Rows"
          },
          "missing_cells": {
            "type": "integer",
            "title": "Missing Cells"
          },
          "exclusions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Exclusions"
          },
          "warnings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Warnings"
          },
          "feature_allowlist": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Feature Allowlist"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "license": {
            "type": "string",
            "title": "License"
          },
          "eligible_count": {
            "type": "integer",
            "title": "Eligible Count"
          },
          "workflow_revision": {
            "type": "integer",
            "title": "Workflow Revision"
          },
          "current_snapshot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Snapshot Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "provenance": {
            "type": "string",
            "title": "Provenance"
          },
          "sync_mode": {
            "type": "string",
            "title": "Sync Mode"
          }
        },
        "type": "object",
        "required": [
          "cohort_id",
          "source_hash",
          "schema_version",
          "accepted_ids",
          "accepted_count",
          "source_count",
          "excluded_count",
          "missing_rows",
          "missing_cells",
          "exclusions",
          "warnings",
          "feature_allowlist",
          "source",
          "license",
          "eligible_count",
          "workflow_revision",
          "current_snapshot_id",
          "session_id",
          "provenance",
          "sync_mode"
        ],
        "title": "CohortRead"
      },
      "ComparisonRequest": {
        "properties": {
          "cohort_id": {
            "type": "string",
            "title": "Cohort Id",
            "default": "uci-hf-299-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ComparisonRequest"
      },
      "ContextRequest": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Snapshot Id"
          },
          "patient_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^HF-\\d{4}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id"
        ],
        "title": "ContextRequest"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "predicate": {
            "type": "string",
            "title": "Predicate"
          },
          "scale": {
            "type": "string",
            "title": "Scale"
          },
          "points": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Points"
          },
          "contribution": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contribution"
          }
        },
        "type": "object",
        "required": [
          "id",
          "field",
          "value",
          "predicate",
          "scale"
        ],
        "title": "Evidence"
      },
      "Facts": {
        "properties": {
          "age": {
            "type": "number",
            "title": "Age"
          },
          "anaemia": {
            "type": "boolean",
            "title": "Anaemia"
          },
          "creatinine_phosphokinase": {
            "type": "number",
            "title": "Creatinine Phosphokinase"
          },
          "diabetes": {
            "type": "boolean",
            "title": "Diabetes"
          },
          "ejection_fraction": {
            "type": "number",
            "title": "Ejection Fraction"
          },
          "high_blood_pressure": {
            "type": "boolean",
            "title": "High Blood Pressure"
          },
          "platelets": {
            "type": "number",
            "title": "Platelets"
          },
          "serum_creatinine": {
            "type": "number",
            "title": "Serum Creatinine"
          },
          "serum_sodium": {
            "type": "number",
            "title": "Serum Sodium"
          },
          "sex": {
            "type": "boolean",
            "title": "Sex"
          },
          "smoking": {
            "type": "boolean",
            "title": "Smoking"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "age",
          "anaemia",
          "creatinine_phosphokinase",
          "diabetes",
          "ejection_fraction",
          "high_blood_pressure",
          "platelets",
          "serum_creatinine",
          "serum_sodium",
          "sex",
          "smoking"
        ],
        "title": "Facts"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MutationResult": {
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "sync_status": {
            "type": "string",
            "title": "Sync Status"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed"
          }
        },
        "type": "object",
        "required": [
          "snapshot",
          "revision",
          "sync_status",
          "replayed"
        ],
        "title": "MutationResult"
      },
      "OrganIndicator": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "flagged",
              "not_flagged",
              "unknown"
            ],
            "title": "State"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "enum": [
              "%",
              "mg/dL"
            ],
            "title": "Unit"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "required": [
          "state",
          "value",
          "unit",
          "label",
          "evidence_ids"
        ],
        "title": "OrganIndicator"
      },
      "Organs": {
        "properties": {
          "heart": {
            "$ref": "#/components/schemas/OrganIndicator"
          },
          "kidney_left": {
            "$ref": "#/components/schemas/OrganIndicator"
          },
          "kidney_right": {
            "$ref": "#/components/schemas/OrganIndicator"
          }
        },
        "type": "object",
        "required": [
          "heart",
          "kidney_left",
          "kidney_right"
        ],
        "title": "Organs"
      },
      "Override": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pin",
              "defer"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reason",
          "sequence",
          "actor"
        ],
        "title": "Override"
      },
