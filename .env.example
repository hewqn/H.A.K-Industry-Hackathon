# COMMITTED TEMPLATE. Copy to .env for local development; .env is ignored by Git.
# No API credentials are required to inspect the scaffold or run its local data slice.
#
# APIS TO CONNECT (each workstream owns its integration):
# 1. FastAPI: frontend requests /api/v1 through Vite's localhost:8000 proxy.
#    Backend owner implements persistence, workflow commands, and validated read models.
# 2. Databricks SQL: backend owner supplies an approved workspace hostname, SQL warehouse
#    HTTP path, catalog/schema, and permitted server credential. It reads cohort features,
#    frozen predictions/reports and persists workflow events/summary cache in Delta.
#    If external credentials are unavailable, use checksummed notebook export/import.
# 3. Databricks MLflow: ML owner configures the workspace experiment and records model,
#    split, evaluation, and prediction versions. It is a training/tracking connection,
#    not a per-patient frontend call. Serving is optional and not required for the scaffold.
# 4. ElevenLabs: the integrating owner configures a private conversational agent plus
#    allowlisted evidence tools. Backend supplies short-lived session credentials;
#    frontend connects microphone, playback, transcript, and organ/patient navigation.
# 5. Summary LLM: optional Databricks Foundation Model or other structured-output provider.
#    Backend must validate returned facts/evidence and fall back to the factual template.
# Keep ALL provider keys server-side. Never put keys in VITE_* variables or the browser.

HF_MODE=offline
HF_SESSION_ID=demo
HF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
HF_CATALOG=
HF_SCHEMA=hf_hackathon
MLFLOW_EXPERIMENT_NAME=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Current voice transport is browser client tools. HF_VOICE_TOOL_TOKEN is reserved
# for a future server-webhook transport and is NOT sent to the browser or required.
HF_VOICE_TOOL_TOKEN=
# End each voice/text conversation after this many seconds (30–900).
# Run scripts/configure_voice_agent.py --apply after changing this value so the
# provider enforces the same duration limit as the dashboard.
HF_VOICE_MAX_DURATION_SECONDS=300
# Bound private-session/context creation per client address each minute.
HF_VOICE_SESSION_REQUESTS_PER_MINUTE=5
HF_SUMMARY_PROVIDER=template
HF_SUMMARY_ENDPOINT=
HF_SUMMARY_API_KEY=
