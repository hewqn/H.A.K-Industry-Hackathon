    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
